  "incidents": [
    {"id": "INC-101", "title": "Redis cluster failover caused cache outage", "severity": "SEV1", "startedAt": "2026-04-08T09:12:00Z", "durationMinutes": 47, "rootCause": "The primary node failed during a maintenance window and the replica was promoted late, so cache reads and rate-limit counters timed out.", "originatedIn": "redis-cache", "affected": ["redis-cache", "api-gateway", "user-service", "catalog-service", "search-service", "cart-service", "web-app", "mobile-bff"], "responders": ["sara-lindqvist", "rohan-mehta"]},
    {"id": "INC-102", "title": "Expired TLS certificate broke logins", "severity": "SEV2", "startedAt": "2026-04-23T14:30:00Z", "durationMinutes": 85, "rootCause": "The internal certificate used by auth-service expired because renewal alerts were routed to a retired mailing list.", "originatedIn": "auth-service", "affected": ["auth-service", "api-gateway", "payments-service", "checkout-service", "web-app", "mobile-bff"], "responders": ["priya-nair", "daniel-okafor"]},
    {"id": "INC-103", "title": "Ledger database ran out of disk space", "severity": "SEV1", "startedAt": "2026-05-12T19:05:00Z", "durationMinutes": 132, "rootCause": "Transaction logs grew faster than expected after a promotion, and the disk usage alert threshold was set too high.", "originatedIn": "ledger-db", "affected": ["ledger-db", "payments-service", "billing-service", "checkout-service", "invoice-service", "web-app", "mobile-bff"], "responders": ["asha-verma", "marcus-chen"]},
    {"id": "INC-104", "title": "Bad feature-flag rollout returned 500 errors", "severity": "SEV3", "startedAt": "2026-05-28T03:40:00Z", "durationMinutes": 25, "rootCause": "A typo in a routing flag was published without validation, so the gateway could not load its route table.", "originatedIn": "config-service", "affected": ["config-service", "api-gateway", "auth-service", "email-worker", "monitoring-service", "web-app", "mobile-bff"], "responders": ["hannah-brooks", "rohan-mehta"]},
    {"id": "INC-105", "title": "Kafka partition imbalance delayed order events", "severity": "SEV2", "startedAt": "2026-06-14T11:20:00Z", "durationMinutes": 64, "rootCause": "One broker held most of the busy partitions, so consumers lagged and order, shipping and notification events arrived late.", "originatedIn": "message-queue", "affected": ["message-queue", "order-service", "shipping-service", "inventory-service", "notification-service", "payments-service", "event-ingest"], "responders": ["rohan-mehta", "noah-fischer"]},
    {"id": "INC-106", "title": "Slow catalog queries after schema migration", "severity": "SEV2", "startedAt": "2026-06-30T16:45:00Z", "durationMinutes": 58, "rootCause": "A migration dropped an index on the product table, so catalog queries fell back to full table scans.", "originatedIn": "catalog-db", "affected": ["catalog-db", "catalog-service", "inventory-service", "cart-service", "search-service", "web-app", "mobile-bff"], "responders": ["aisha-khan", "sara-lindqvist"]},
    {"id": "INC-107", "title": "Fraud model release declined valid payments", "severity": "SEV3", "startedAt": "2026-07-09T08:15:00Z", "durationMinutes": 40, "rootCause": "A new scoring model shipped with a wrong threshold, causing a spike of false declines at checkout.", "originatedIn": "fraud-service", "affected": ["fraud-service", "payments-service", "billing-service", "checkout-service", "web-app"], "responders": ["elena-petrova", "asha-verma"]},
    {"id": "INC-108", "title": "User database primary failed, slow failover", "severity": "SEV1", "startedAt": "2026-07-22T21:00:00Z", "durationMinutes": 156, "rootCause": "The primary host failed and automated failover stalled, so a replica had to be promoted by hand.", "originatedIn": "user-db", "affected": ["user-db", "user-service", "auth-service", "fraud-service", "notification-service", "api-gateway", "payments-service", "checkout-service", "web-app", "mobile-bff"], "responders": ["daniel-okafor", "priya-nair", "sara-lindqvist"]},
    {"id": "INC-109", "title": "Search index rebuild saturated CPU", "severity": "SEV3", "startedAt": "2026-08-05T13:30:00Z", "durationMinutes": 35, "rootCause": "A full reindex ran during peak hours and starved live search queries of CPU.", "originatedIn": "search-service", "affected": ["search-service", "web-app"], "responders": ["mei-tanaka", "aisha-khan"]},
    {"id": "INC-110", "title": "Order database connection pool exhausted", "severity": "SEV2", "startedAt": "2026-08-19T10:10:00Z", "durationMinutes": 72, "rootCause": "A flash sale tripled order traffic and the connection pool limit was too low for the new load.", "originatedIn": "order-db", "affected": ["order-db", "order-service", "checkout-service", "shipping-service", "web-app", "mobile-bff"], "responders": ["liam-byrne", "tomas-rivera"]},
    {"id": "INC-111", "title": "Notification consumer lag caused duplicate alerts", "severity": "SEV3", "startedAt": "2026-09-03T06:50:00Z", "durationMinutes": 30, "rootCause": "A stuck consumer reprocessed the same messages after a restart, sending duplicate push notifications and invoice emails.", "originatedIn": "notification-service", "affected": ["notification-service", "invoice-service", "mobile-bff"], "responders": ["karan-singh", "mei-tanaka"]},
    {"id": "INC-112", "title": "Gateway rate limiter misconfigured after cache upgrade", "severity": "SEV2", "startedAt": "2026-09-24T17:25:00Z", "durationMinutes": 90, "rootCause": "A cache client upgrade changed key formats, so the gateway's rate-limit rules blocked normal traffic.", "originatedIn": "api-gateway", "affected": ["api-gateway", "web-app", "mobile-bff"], "responders": ["rohan-mehta", "sara-lindqvist"]}
  ]
