# Copy this file to .env.local and fill in your values:  cp .env.example .env.local
# Only GOOGLE_GENERATIVE_AI_API_KEY is required for local development.

# Gemini API key, from https://aistudio.google.com/apikey (the free tier is enough)
GOOGLE_GENERATIVE_AI_API_KEY=

# Which Gemini model the agent uses (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# FalkorDB connection. The defaults match a local Docker container:
#   docker run -p 6379:6379 -it --rm falkordb/falkordb
# For FalkorDB Cloud, copy the host, port, username and password from the instance's Connect button.
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FALKORDB_TLS=false
# FALKORDB_GRAPH=outages

# Set to false to turn off the createIncident tool (recommended for a public deployment)
# ALLOW_WRITES=false

# Link shown in the "Demo limit reached" notice when the Gemini quota runs out
# NEXT_PUBLIC_DEMO_VIDEO_URL=
